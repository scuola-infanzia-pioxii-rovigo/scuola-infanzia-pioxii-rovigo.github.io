---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina non trovata" noindex>
  <div class="wrap notfound">
    <p class="eyebrow">Errore 404</p>
    <h1>Questa pagina non c’è.</h1>
    <p style="font-size:1.2rem;color:var(--ink-2)">Forse il link è cambiato. Da qui puoi tornare alla home.</p>
    <p><a class="btn btn-dark" href="/">Torna alla home</a></p>
  </div>
</Layout>
